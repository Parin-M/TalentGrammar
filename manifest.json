{
  "manifest_version": 3,
  "name": "TalentGrammar",
  "version": "0.2.0",
  "description": "Offline Persian and English proofreading.",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TalentGrammar"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
